/* ============================================================================
   Криптоалгоритм для РуСи89 - РАБОЧАЯ ВЕРСИЯ
   ============================================================================ */

овз print_str(char *s)
{
    цп (*s) {
        putchar(*s);
        s = s + 1;
    }
}

овз print_hex_char(char б)
{
    char *hex;
    hex = "0123456789abcdef";
    putchar(hex[(б >> 4) & 0x0F]);
    putchar(hex[б & 0x0F]);
}

овз print_hex_space(char б)
{
    print_hex_char(б);
    putchar(' ');
}

/* XOR шифрование с выводом результата */
овз xor_encrypt_demo(char *данные, char *ключ)
{
    цел ч;
    цел длина;
    цел длинаключа;
    
    длина = 0;
    цп (данные[длина]) {
        длина = длина + 1;
    }
    
    длинаключа = 0;
    цп (ключ[длинаключа]) {
        длинаключа = длинаключа + 1;
    }
    
    for (ч = 0; ч < длина; ч = ч + 1) {
        char c;
        c = данные[ч] ^ ключ[ч % длинаключа];
        print_hex_space(c);
    }
    print_str("\n");
}

/* Простейшее шифрование (XOR с фиксированным ключом) */
char xor_encrypt_char(char c, char ключ)
{
    вернуть c ^ ключ;
}

/* Простейшее дешифрование (то же самое) */
char xor_decrypt_char(char c, char ключ)
{
    вернуть c ^ ключ;
}

цел запуск()
{
    char *сообщение;
    char *ключ;
    
    сообщение = "Hello";
    ключ = "ключ";
    
    print_str("=== XOR КРИПТО ДЕМКА ===\n");
    print_str("сообщение: ");
    print_str(сообщение);
    print_str("\n");
    
    print_str("ключ: ");
    print_str(ключ);
    print_str("\n\n");
    
    print_str("Зашифрован (16-ричн): ");
    xor_encrypt_demo(сообщение, ключ);
    
    print_str("\n");
    print_str("Пример шифрования одного символа:\n");
    print_str("'A' XOR 'K' = ");
    print_hex_char(xor_encrypt_char('A', 'K'));
    print_str("\n");
    
    вернуть 0;
}
