цел запуск() {
    цел i = 0;
    цел j = 0;
    цел k = 0;
    цел сумма = 0;
    цел чётные = 0;
    цел нечётные = 0;
    
    sys_write(1, "=== Тест трёхуровневых вложенных циклов ===\n", strlen("=== Тест трёхуровневых вложенных циклов ===\n"));
    
    цп (i < 2) {
        sys_write(1, "\n--- Уровень 1: i = ", strlen("\n--- Уровень 1: i = "));
        print_int(i);
        sys_write(1, " ---\n", strlen(" ---\n"));
        
        j = 0;
        цп (j < 2) {
            sys_write(1, "  --- Уровень 2: j = ", strlen("  --- Уровень 2: j = "));
            print_int(j);
            sys_write(1, " ---\n", strlen(" ---\n"));
            
            k = 0;
            цп (k < 2) {
                sys_write(1, "    Уровень 3: k = ", strlen("    Уровень 3: k = "));
                print_int(k);
                
                сумма = сумма + i + j + k;
                
                /* Проверка на чётность суммы */
                если ((i + j + k) % 2 == 0) {
                    sys_write(1, " (чётная сумма)\n", strlen(" (чётная сумма)\n"));
                    чётные = чётные + 1;
                } иначе {
                    sys_write(1, " (нечётная сумма)\n", strlen(" (нечётная сумма)\n"));
                    нечётные = нечётные + 1;
                }
                
                k = k + 1;
            }
            
            j = j + 1;
        }
        
        i = i + 1;
    }
    
    sys_write(1, "\n=== Результаты ===\n", strlen("\n=== Результаты ===\n"));
    sys_write(1, "Общая сумма i+j+k = ", strlen("Общая сумма i+j+k = "));
    print_int(сумма);
    sys_write(1, "\n", 1);
    
    sys_write(1, "Чётных сумм: ", strlen("Чётных сумм: "));
    print_int(чётные);
    sys_write(1, "\n", 1);
    
    sys_write(1, "Нечётных сумм: ", strlen("Нечётных сумм: "));
    print_int(нечётные);
    sys_write(1, "\n", 1);
    
    вернуть 0;
}
