/* Тест всех математических операций */

цел сложить(цел a, цел b) {
    вернуть a + b;
}

цел вычесть(цел a, цел b) {
    вернуть a - b;
}

цел умножить(цел a, цел b) {
    вернуть a * b;
}

цел разделить(цел a, цел b) {
    вернуть a / b;
}

цел остаток(цел a, цел b) {
    вернуть a % b;
}



овз тестуказателей() {
    цел число = 43;
    овз* указатель = &число;
    цел* цел_указатель = указатель;
    sys_write(1, "\n", 1);
    sys_write(1, "цел_указатель = ", strlen("цел_указатель = "));
    print_int(*цел_указатель);
    sys_write(1, "\n", 1);
}



цел условие() {
    цел x = 42;
    цел y = 0;
    
    если (x == 42) {
        y = 100;
    } иначе {
        y = 200;
    }

    sys_write(1, "\n", 1);
    sys_write(1, "по_условию = ", strlen("по_условию = "));
    print_int(y);
    sys_write(1, "\n", 1);
    вернуть y;
}


цел запуск() {
    цел a = 20;
    цел b = 7;
    цел сумма;
    цел разность;
    цел произведение;
    цел частное;
    цел модуль;
    
    sys_write(1, "=== Тест математических операций ===\n", strlen("=== Тест математических операций ===\n"));
    
    /* Сложение */
    сумма = сложить(a, b);
    sys_write(1, "20 + 7 = ", strlen("20 + 7 = "));
    print_int(сумма);
    sys_write(1, "\n", 1);
    
    /* Вычитание */
    разность = вычесть(a, b);
    sys_write(1, "20 - 7 = ", strlen("20 - 7 = "));
    print_int(разность);
    sys_write(1, "\n", 1);
    
    /* Умножение */
    произведение = умножить(a, b);
    sys_write(1, "20 * 7 = ", strlen("20 * 7 = "));
    print_int(произведение);
    sys_write(1, "\n", 1);
    
    /* Деление */
    частное = разделить(a, b);
    sys_write(1, "20 / 7 = ", strlen("20 / 7 = "));
    print_int(частное);
    sys_write(1, "\n", 1);
    
    /* Остаток от деления */
    модуль = остаток(a, b);
    sys_write(1, "20 % 7 = ", strlen("20 % 7 = "));
    print_int(модуль);
    sys_write(1, "\n", 1);
    
    /* Сложное выражение */
    sys_write(1, "(20 + 7) * (20 - 7) = ", strlen("(20 + 7) * (20 - 7) = "));
    print_int(умножить(сложить(a, b), вычесть(a, b)));
    sys_write(1, "\n", 1);


    тестуказателей();

    условие();
    

    sys_write(1, "=============================\n", strlen("=============================\n"));
    
    
    sys_write(1, "\n=== Все тесты пройдены ===\n", strlen("\n=== Все тесты пройдены ===\n"));


    вернуть 0;
}
