/* Тест всех математических операций */

цел сложить(цел a, цел b) {
    вернуть a + b;
}

цел вычесть(цел a, цел b) {
    вернуть a - b;
}

цел умножить(цел a, цел b) {
    вернуть a * b;
}

цел разделить(цел a, цел b) {
    вернуть a / b;
}

цел остаток(цел a, цел b) {
    вернуть a % b;
}



овз тестуказателей() {
    цел число = 43;
    овз* указатель = &число;
    цел* цел_указатель = указатель;
    печать(1, "\n", 1);
    печать(1, "цел_указатель = ", длина_строки("цел_указатель = "));
    печать_цел(*цел_указатель);
    печать(1, "\n", 1);
}



цел условие() {
    цел x = 42;
    цел y = 0;
    
    если (x == 42) {
        y = 100;
    } иначе {
        y = 200;
    }

    печать(1, "\n", 1);
    печать(1, "по_условию = ", длина_строки("по_условию = "));
    печать_цел(y);
    печать(1, "\n", 1);
    вернуть y;
}


цел тестциклов(){
    цел i = 0;
    цел j = 0;
    цел k = 0;
    цел сумма = 0;
    цел чётные = 0;
    цел нечётные = 0;

    печать(1, "\n", 1);
    
    печать(1, "=== Тест трёхуровневых вложенных циклов ===\n", длина_строки("=== Тест трёхуровневых вложенных циклов ===\n"));
    
    цп (i < 2) {
        печать(1, "\n--- Уровень 1: i = ", длина_строки("\n--- Уровень 1: i = "));
        печать_цел(i);
        печать(1, " ---\n", длина_строки(" ---\n"));
        
        j = 0;
        цп (j < 2) {
            печать(1, "  --- Уровень 2: j = ", длина_строки("  --- Уровень 2: j = "));
            печать_цел(j);
            печать(1, " ---\n", длина_строки(" ---\n"));
            
            k = 0;
            цп (k < 2) {
                печать(1, "    Уровень 3: k = ", длина_строки("    Уровень 3: k = "));
                печать_цел(k);
                
                сумма = сумма + i + j + k;
                
                /* Проверка на чётность суммы */
                если ((i + j + k) % 2 == 0) {
                    печать(1, " (чётная сумма)\n", длина_строки(" (чётная сумма)\n"));
                    чётные = чётные + 1;
                } иначе {
                    печать(1, " (нечётная сумма)\n", длина_строки(" (нечётная сумма)\n"));
                    нечётные = нечётные + 1;
                }
                
                k = k + 1;
            }
            
            j = j + 1;
        }
        
        i = i + 1;
    }
    
    печать(1, "\n=== Результаты ===\n", длина_строки("\n=== Результаты ===\n"));
    печать(1, "Общая сумма i+j+k = ", длина_строки("Общая сумма i+j+k = "));
    печать_цел(сумма);
    печать(1, "\n", 1);
    
    печать(1, "Чётных сумм: ", длина_строки("Чётных сумм: "));
    печать_цел(чётные);
    печать(1, "\n", 1);
    
    печать(1, "Нечётных сумм: ", длина_строки("Нечётных сумм: "));
    печать_цел(нечётные);
    печать(1, "\n", 1);
    
    вернуть 0;
}


цел запуск() {
    цел a = 20;
    цел b = 7;
    цел сумма;
    цел разность;
    цел произведение;
    цел частное;
    цел модуль;
    
    печать(1, "=== Тест математических операций ===\n", длина_строки("=== Тест математических операций ===\n"));
    
    /* Сложение */
    сумма = сложить(a, b);
    печать(1, "20 + 7 = ", длина_строки("20 + 7 = "));
    печать_цел(сумма);
    печать(1, "\n", 1);
    
    /* Вычитание */
    разность = вычесть(a, b);
    печать(1, "20 - 7 = ", длина_строки("20 - 7 = "));
    печать_цел(разность);
    печать(1, "\n", 1);
    
    /* Умножение */
    произведение = умножить(a, b);
    печать(1, "20 * 7 = ", длина_строки("20 * 7 = "));
    печать_цел(произведение);
    печать(1, "\n", 1);
    
    /* Деление */
    частное = разделить(a, b);
    печать(1, "20 / 7 = ", длина_строки("20 / 7 = "));
    печать_цел(частное);
    печать(1, "\n", 1);
    
    /* Остаток от деления */
    модуль = остаток(a, b);
    печать(1, "20 % 7 = ", длина_строки("20 % 7 = "));
    печать_цел(модуль);
    печать(1, "\n", 1);
    
    /* Сложное выражение */
    печать(1, "(20 + 7) * (20 - 7) = ", длина_строки("(20 + 7) * (20 - 7) = "));
    печать_цел(умножить(сложить(a, b), вычесть(a, b)));
    печать(1, "\n", 1);


    тестуказателей();

    условие();

    тестциклов();
    

    печать(1, "=============================\n", длина_строки("=============================\n"));
    
    
    печать(1, "\n=== Все тесты пройдены ===\n", длина_строки("\n=== Все тесты пройдены ===\n"));


    вернуть 0;
}
