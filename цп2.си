цел запуск() {
    цел i = 0;
    цел j = 0;
    цел сумма = 0;
    
    sys_write(1, "=== Тест вложенных циклов цп ===\n", strlen("=== Тест вложенных циклов цп ===\n"));
    
    цп (i < 3) {
        sys_write(1, "Внешний цикл: i = ", strlen("Внешний цикл: i = "));
        print_int(i);
        sys_write(1, "\n", 1);
        
        j = 0;
        цп (j < 3) {
            sys_write(1, "  Внутренний цикл: j = ", strlen("  Внутренний цикл: j = "));
            print_int(j);
            sys_write(1, "\n", 1);
            
            сумма = сумма + i + j;
            j = j + 1;
        }
        
        i = i + 1;
    }
    
    sys_write(1, "=== Циклы завершены ===\n", strlen("=== Циклы завершены ===\n"));
    sys_write(1, "Сумма всех i + j = ", strlen("Сумма всех i + j = "));
    print_int(сумма);
    sys_write(1, "\n", 1);
    
    вернуть сумма;
}
